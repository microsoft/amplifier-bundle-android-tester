    disclaimer [label="\"tok\" = tokens, a rough measure of how much reading the AI does\nEstimates: ~4 characters per token\nSolid border = built here (counted)\nDashed + red = borrowed from elsewhere, adds hidden cost (not counted)\nDashed + muted = borrowed from elsewhere, no added cost\nNot counted: helper sessions, anything decided while running", shape=note, fillcolor="#eceff1", style="filled", fontsize=9]

